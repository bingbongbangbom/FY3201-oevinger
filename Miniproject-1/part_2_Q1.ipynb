   "source": [
    "import numpy as np\n",
    "\n",
    "moving_average = np.array([1.2, 4.1, 5.2, 9.2])                   \n",
    "time = np.array([1800, 1801, 1802, 1803])\n",
    "A = np.column_stack((moving_average.T, np.ones_like(moving_average.T))) \n",
    "b = time.T\n",
    "\n",
    "v = np.linalg.lstsq(A,b)\n",
    "print(v[0], v[1])\n",
    "\n"
